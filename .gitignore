# --- Secrets -----------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Runtime data ------------------------------------------------------------
# Uploads and dumps live in Docker volumes; these are the local-run equivalents.
backend/var/
uploads/
backups/
*.dump

# --- Node (frontend, milestone 2) --------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- The launcher ------------------------------------------------------------
# Both are made on the machine that runs it, not checked in: the window's icon
# is drawn at startup, and the error note only exists when something went wrong.
.stratum-icon.ico
stratum-launcher-error.txt

# Written by the log viewer, for sending on when something goes wrong. It never
# reads .env, so it is safe to pass around - but it is generated, not source.
stratum-log.txt
