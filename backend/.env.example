# Local (non-Docker) development settings.
#
# Copy to backend/.env when running `uvicorn app.main:app --reload` directly
# against a PostgreSQL you started yourself. When using Docker Compose, edit
# the repository-root .env instead — this file is not read by the container.

ENVIRONMENT=development
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=archeo
POSTGRES_PASSWORD=archeo
POSTGRES_DB=archeo

SECRET_KEY=dev-only-secret-change-before-any-shared-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=ChangeMe!2024

STORAGE_ROOT=./var/uploads
