# Copy to .env and edit before the first `docker compose up`.
#
#   cp .env.example .env
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# --- Database ---------------------------------------------------------------
# Only the backend connects to PostgreSQL; the port is not published to the
# host by default (see docker-compose.yml).
POSTGRES_USER=archeo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archeo

# --- Security ---------------------------------------------------------------
# REQUIRED. Signs every JWT — changing it signs everyone out.
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Where the site lives for a human. QR labels encode this address, so a scanned
# finds bag opens a page rather than raw JSON — set it to your real hostname
# before printing any labels, or they will point at localhost forever.
FRONTEND_URL=http://localhost:5173

# --- Serving it to other people ------------------------------------------
# Only used by docker-compose.prod.yml. Ignored when you run it locally.
#
# SITE_ADDRESS is what the web server answers on:
#
#   :80                     an office network. Plain HTTP, reached by IP.
#   stratum.example.org     the internet. An HTTPS certificate is obtained
#                           and renewed automatically — nothing to run, and
#                           nothing to remember in ninety days.
#
# The second form needs that name already pointing at this machine, and
# ports 80 and 443 reachable from outside, because that is how the
# certificate authority checks you control it.
SITE_ADDRESS=:80

# The address people type. Must match how they actually reach it, including
# http:// or https:// — it is what the platform puts in QR codes and e-mails.
PUBLIC_URL=http://localhost

# --- Where the uploaded files live ---------------------------------------
# Only used by docker-compose.storage.yml. Leave it commented out and Docker
# keeps everything in its own area, which is on C: whatever else you do.
#
# Set it to put the *original uploaded files* — photographs, drone imagery,
# 3D models, documents, floor plan scans — on a disk you choose. This is the
# part that grows to hundreds of gigabytes.
#
# Create the folder yourself before the first run. Windows paths use forward
# slashes here.
#
#   DATA_ROOT=D:/stratum-data
#   DATA_ROOT=/Volumes/Archive/stratum
#
# The database itself deliberately stays where it is — see the note in
# docker-compose.storage.yml for why.
#DATA_ROOT=D:/stratum-data

# Where the nightly database dumps go. Unset, they land beside the
# photographs, on the same physical disk — which protects against somebody
# deleting a record, and not against the disk failing. That single failure
# takes the originals *and* every backup of the catalogue describing them.
#
# A backup on the same disk as the thing it backs up is a copy, not a backup.
# Any second disk beats none, and it need not be large: the dumps hold the
# records, not the photographs, so a month of them is a few gigabytes.
#
#   BACKUP_ROOT=E:/stratum-backups
#BACKUP_ROOT=E:/stratum-backups

# --- First administrator ----------------------------------------------------
# Created on first boot. Change the password immediately after signing in.
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-this-admin-password

# --- Storage ----------------------------------------------------------------
# Per-file ceiling, checked while reading rather than trusting the length the
# client declares. Raise it if you host meshes; photographs never need this much.
MAX_UPLOAD_SIZE_MB=200

# Longest edge of each generated thumbnail, comma-separated. One JPEG is written
# per size when a photograph is uploaded. Adding a size here does not regenerate
# thumbnails for photographs already stored.
THUMBNAIL_SIZES=200,800

# Uploads live in the ``uploads`` Docker volume. Back it up alongside the
# database: the database holds only the paths, not the files, so a restore
# without it leaves every photograph as a broken link. The path inside the
# container is fixed in docker-compose.yml, because it has to match the mount.

# --- Startup behaviour ------------------------------------------------------
# Migrations and reference-data seeding both run on container start and are
# safe to repeat. Sample data is the demonstration project — leave it off for
# a real deployment.
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_SAMPLE_DATA=false

# --- Backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

# --- E-mail (optional) ------------------------------------------------------
# For password resets, project invitations, and data-request correspondence.
#
# Leave this whole block commented out and the platform runs perfectly well
# and simply sends nothing — which is the right way to run it on a machine in
# a dig house with no outbound mail.
#
# For Gmail, SMTP_PASSWORD is an **App Password**, not the password you type
# into Gmail. Step-by-step: docs/email-setup.md. Paste it either as the four
# groups of four Google shows you, or without the spaces; both work.
#
# Whatever you set here stays on this machine. This file is .env.example and
# is committed; the real .env is git-ignored, and the password belongs only in
# that one — never in the repository, a screenshot, or a message.
#
# Check it with:  cd backend && python scripts/check_email.py
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM_NAME=Stratum
#
# Port 465 instead of 587 means a different kind of encryption:
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_STARTTLS=false
