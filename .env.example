# Copy to .env and edit before the first `docker compose up`.
#
#   cp .env.example .env
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# --- Database ---------------------------------------------------------------
# Only the backend connects to PostgreSQL; the port is not published to the
# host by default (see docker-compose.yml).
POSTGRES_USER=archeo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archeo

# --- Security ---------------------------------------------------------------
# REQUIRED. Signs every JWT — changing it signs everyone out.
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Where the site lives for a human. QR labels encode this address, so a scanned
# finds bag opens a page rather than raw JSON — set it to your real hostname
# before printing any labels, or they will point at localhost forever.
FRONTEND_URL=http://localhost:5173

# --- Serving it to other people ------------------------------------------
# Only used by docker-compose.prod.yml. Ignored when you run it locally.
#
# SITE_ADDRESS is what the web server answers on:
#
#   :80                     an office network. Plain HTTP, reached by IP.
#   stratum.example.org     the internet. An HTTPS certificate is obtained
#                           and renewed automatically — nothing to run, and
#                           nothing to remember in ninety days.
#
# The second form needs that name already pointing at this machine, and
# ports 80 and 443 reachable from outside, because that is how the
# certificate authority checks you control it.
SITE_ADDRESS=:80

# The address people type. Must match how they actually reach it, including
# http:// or https:// — it is what the platform puts in QR codes and e-mails.
PUBLIC_URL=http://localhost

# --- First administrator ----------------------------------------------------
# Created on first boot. Change the password immediately after signing in.
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-this-admin-password

# --- Storage ----------------------------------------------------------------
# Per-file ceiling, checked while reading rather than trusting the length the
# client declares. Raise it if you host meshes; photographs never need this much.
MAX_UPLOAD_SIZE_MB=200

# Longest edge of each generated thumbnail, comma-separated. One JPEG is written
# per size when a photograph is uploaded. Adding a size here does not regenerate
# thumbnails for photographs already stored.
THUMBNAIL_SIZES=200,800

# Uploads live in the ``uploads`` Docker volume. Back it up alongside the
# database: the database holds only the paths, not the files, so a restore
# without it leaves every photograph as a broken link. The path inside the
# container is fixed in docker-compose.yml, because it has to match the mount.

# --- Startup behaviour ------------------------------------------------------
# Migrations and reference-data seeding both run on container start and are
# safe to repeat. Sample data is the demonstration project — leave it off for
# a real deployment.
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_SAMPLE_DATA=false

# --- Backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
