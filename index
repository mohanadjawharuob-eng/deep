<!DOCTYPE html>
<html>
  <head>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
    <script src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>
  </head>
  <body style="margin: 0; overflow: hidden;">
    <!-- The 'scene' holds all 3D elements -->
    <a-scene
      embedded
      arjs="sourceType: webcam; debugUIEnabled: false; trackingMethod: best;"
      renderer="antialias: true; alpha: false;"
    >
      <!-- This asset pre-loads the video to ensure smooth playback -->
      <a-assets>
        <video
          id="brochure-video"
          src="path/to/your/video.mp4"
          preload="auto"
          crossorigin="anonymous"
          loop
          muted
          playsinline
        ></video>
      </a-assets>

      <!-- The camera entity required for AR -->
      <a-camera static></a-camera>

      <!-- This entity represents the marker (the brochure) -->
      <a-nft
        type="nft"
        url="path/to/your/marker/file.patt"
        smooth="true"
        smoothCount="5"
        smoothTolerance="0.01"
        smoothThreshold="5"
      >
        <!-- This plane will hold the video. It matches the brochure dimensions -->
        <a-plane
          rotation="-90 0 0"
          width="1.33"  <!-- Adjust based on your brochure aspect ratio -->
          height="1"    <!-- e.g., for a landscape brochure -->
          position="0 0 0"
          material="shader: flat; src: #brochure-video; transparent: true;"
          eventsource
        ></a-plane>
      </a-nft>
    </a-scene>

    <!-- Simple script to handle video playback once marker is found -->
    <script>
      AFRAME.registerComponent('eventsource', {
        init: function() {
          let video = document.querySelector('#brochure-video');
          // When the marker is detected, play the video
          this.el.sceneEl.addEventListener('nftmarkerfound', function() {
            video.play().catch(e => console.log("Playback failed (expected if no interaction): ", e));
          });
          // Optional: Pause video when marker is lost
          this.el.sceneEl.addEventListener('nftmarkerlost', function() {
            video.pause();
          });
        }
      });
    </script>
  </body>
</html>
